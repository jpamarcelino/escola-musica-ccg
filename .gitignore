# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...excepto o modelo sem valores, que serve de guia a quem chega
!.env.example

# vercel
.vercel

# preferências locais do Claude Code (caminhos e permissões de cada máquina)
.claude/settings.local.json

# MCP servers pessoais (ex: MiniMax) — não partilhar entre colaboradores
.mcp.json

# Saída gerada pelo MiniMax MCP (imagem/áudio/vídeo)
/minimax-output/

# typescript
*.tsbuildinfo
next-env.d.ts

# servidor local iniciado pelo Codex
.codex-dev-*.log

# Compilacao de verificacao (npm run verificar), a parte da .next que o
# servidor local usa — ver o comentario do distDir em apps/web/next.config.ts
.next-verificacao/

# Ficheiros temporarios da CLI do Supabase
supabase/.temp/
