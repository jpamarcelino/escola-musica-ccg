# Variáveis da app web. Copia este ficheiro para `.env.local` e preenche.
#
# O `.env.local` fica de fora do git (ver .gitignore na raiz) — nunca o
# commites: a service role key ignora todas as regras de RLS e dá acesso
# integral à base de dados da escola.
#
# Só as NEXT_PUBLIC_* chegam ao browser. Tudo o resto vive no servidor.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usada por rotas de servidor e pelo cron. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Códigos que um convite tem de trazer para criar conta de professor ou
# de administrador.
PROFESSOR_INVITE_CODE=
ADMIN_INVITE_CODE=

# Segredo que o Vercel Cron envia no cabeçalho para as tarefas mensais.
CRON_SECRET=

# Contas de teste, para verificar funcionalidades sem tocar em pessoas
# reais. Opcionais — a app corre sem elas.
TEST_PROFESSOR_EMAIL=
TEST_PROFESSOR_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
