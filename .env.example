# Copia este ficheiro para `.env.local` e preenche os valores.
# O `.env.local` nunca vai para o Git — cada pessoa tem o seu.
#
# Os valores reais tiram-se do painel do Supabase e do Vercel; não os
# partilhes por email nem por mensagem.

# --- Supabase ------------------------------------------------------------
# Supabase → Project Settings → API
# Estes dois são públicos por natureza (vão no JavaScript do browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de administração: ignora todas as regras de RLS.
# Só para scripts locais de seed/limpeza. NUNCA usar em código que vai
# para produção, e nunca com o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Códigos de convite --------------------------------------------------
# Quem se regista com um destes códigos fica com o perfil respetivo.
# Ver src/lib/actions/convites.ts
PROFESSOR_INVITE_CODE=
ADMIN_INVITE_CODE=

# --- Cron ----------------------------------------------------------------
# Segredo que autentica o job diário de mensalidades (ver vercel.json e
# src/app/api/cron/mensalidades/route.ts). Gerar com: openssl rand -hex 32
CRON_SECRET=

# --- Contas de teste (opcional, só para desenvolvimento) -----------------
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_PROFESSOR_EMAIL=
TEST_PROFESSOR_PASSWORD=

# Push notifications (Web Push com VAPID).
# Gerar com: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACTO=mailto:geral@ccg.pt
# Segredo partilhado entre a app e o gatilho da base de dados.
# O mesmo valor tem de ficar na tabela push_config.
PUSH_SEGREDO=
